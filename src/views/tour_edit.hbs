<div class="crud-section">
    <h2>Редактирование тура #{{tour.ID}}</h2>
    
    <form method="POST" action="/tours/{{tour.ID}}/update">
        <div class="form-grid">
            <div class="form-group">
                <label for="Name">Название тура *</label>
                <input type="text" id="Name" name="Name" value="{{tour.Name}}" required 
                       placeholder="Название тура">
            </div>
            
            <div class="form-group">
                <label for="tourType">Тип тура *</label>
                <select id="tourType" name="tourType" required>
                    <option value="">Выберите тип</option>
                    <option value="1" {{#if_eq tour.tourType 1}}selected{{/if_eq}}>🏖️ Пляжный</option>
                    <option value="2" {{#if_eq tour.tourType 2}}selected{{/if_eq}}>⛰️ Горный</option>
                    <option value="3" {{#if_eq tour.tourType 3}}selected{{/if_eq}}>🩺 Лечебный</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="price">Цена (₽) *</label>
                <input type="number" id="price" name="price" step="0.01" min="0" 
                       value="{{tour.price}}" required placeholder="0.00">
            </div>
            
            <div class="form-group">
                <label for="seatsAvailable">Доступно мест *</label>
                <input type="number" id="seatsAvailable" name="seatsAvailable" min="0" 
                       value="{{tour.seatsAvailable}}" required placeholder="10">
            </div>
            
            <div class="form-group full-width">
                <label for="description">Описание *</label>
                <textarea id="description" name="description" rows="6" required 
                          placeholder="Подробное описание тура...">{{tour.description}}</textarea>
            </div>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-success">💾 Сохранить изменения</button>
            <a href="/tours" class="btn btn-secondary">← Назад к списку</a>
        </div>
    </form>
    
    <div class="tour-info mt-3">
        <h4>Информация о туре</h4>
        <div class="info-grid">
            <div class="info-item">
                <strong>ID тура:</strong> {{tour.ID}}
            </div>
            <div class="info-item">
                <strong>Тип тура:</strong>
                <span class="tour-type-display type-{{tour.tourType}}">
                    {{#if_eq tour.tourType 1}}🏖️ Пляжный{{/if_eq}}
                    {{#if_eq tour.tourType 2}}⛰️ Горный{{/if_eq}}
                    {{#if_eq tour.tourType 3}}🩺 Лечебный{{/if_eq}}
                </span>
            </div>
            <div class="info-item">
                <strong>Дата создания:</strong> {{formatDate tour.CreatedAt}}
            </div>
            <div class="info-item">
                <strong>Статус:</strong> 
                <span class="status-badge {{#if (gt tour.seatsAvailable 0)}}active{{else}}inactive{{/if}}">
                    {{#if (gt tour.seatsAvailable 0)}}✅ Активен{{else}}⛔ Завершен{{/if}}
                </span>
            </div>
        </div>
        
        <div class="sales-info mt-2">
            <h5>Статистика продаж:</h5>
            <div class="stats-grid">
                <div class="stat-item">
                    <span class="stat-label">Всего продано мест:</span>
                    <span class="stat-value">{{#if tour.totalSales}}{{tour.totalSales}}{{else}}0{{/if}}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Общая выручка:</span>
                    <span class="stat-value">{{#if tour.totalRevenue}}{{tour.totalRevenue}} ₽{{else}}0 ₽{{/if}}</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const descriptionTextarea = document.getElementById('description');
if (descriptionTextarea) {
    const charCount = document.createElement('div');
    charCount.className = 'char-count';
    charCount.style.fontSize = '0.85rem';
    charCount.style.color = '#6c757d';
    charCount.style.marginTop = '0.5rem';
    descriptionTextarea.parentNode.appendChild(charCount);
    
    function updateCharCount() {
        const length = descriptionTextarea.value.length;
        charCount.textContent = `${length} символов`;
        
        if (length < 50) {
            charCount.style.color = '#dc3545';
        } else if (length < 100) {
            charCount.style.color = '#ffc107';
        } else {
            charCount.style.color = '#28a745';
        }
    }
    
    descriptionTextarea.addEventListener('input', updateCharCount);
    updateCharCount();
}
</script>


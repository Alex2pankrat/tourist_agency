    font-weight: bold;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.9rem;
}

.type-1 { background: #ffeaa7; color: #d35400; }
.type-2 { background: #dfe6e9; color: #2c3e50; }
.type-3 { background: #a3e4d7; color: #0d6251; }

.tour-id {
    font-size: 0.8rem;
    color: #6c757d;
    font-family: monospace;
}

.tour-body {
    padding: 1rem;
}

.tour-body h4 {
    margin: 0 0 0.75rem 0;

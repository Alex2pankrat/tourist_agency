<div class="crud-section">
    <div class="section-header">
        <h2>Управление турами</h2>
        <div class="header-actions">
            <button onclick="showAddForm()" class="btn btn-primary">➕ Добавить тур</button>
        </div>
    </div>

    <!-- Форма добавления -->
    <div id="addForm" class="form-section" style="display: none;">
        <h3>Добавить новый тур</h3>
        <form method="POST" action="/tours">
            <div class="form-grid">
                <div class="form-group">
                    <label for="Name">Название тура *</label>
                    <input type="text" id="Name" name="Name" required placeholder="Название тура">
                </div>
                <div class="form-group">
                    <label for="tourType">Тип тура *</label>
                    <select id="tourType" name="tourType" required>
                        <option value="">Выберите тип</option>
                        <option value="1">🏖️ Пляжный</option>
                        <option value="2">⛰️ Горный</option>
                        <option value="3">🩺 Лечебный</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="price">Цена (₽) *</label>
                    <input type="number" id="price" name="price" step="0.01" min="0" required placeholder="0.00">
                </div>
                <div class="form-group">
                    <label for="seatsAvailable">Доступно мест *</label>
                    <input type="number" id="seatsAvailable" name="seatsAvailable" min="1" required placeholder="10">
                </div>
                <div class="form-group full-width">
                    <label for="description">Описание *</label>
                    <textarea id="description" name="description" rows="4" required placeholder="Подробное описание тура..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-success">Сохранить тур</button>
                <button type="button" class="btn btn-secondary" onclick="hideAddForm()">Отмена</button>
            </div>
        </form>
    </div>

    <!-- Список туров -->
    <div class="data-section">
        <h3>Каталог туров</h3>
        {{#if tours.length}}
        <div class="tours-grid">
            {{#each tours}}
            <div class="tour-card">
                <div class="tour-header">
                    <span class="tour-type type-{{this.tourType}}">
                        {{#if_eq this.tourType 1}}🏖️ Пляжный{{/if_eq}}
                        {{#if_eq this.tourType 2}}⛰️ Горный{{/if_eq}}
                        {{#if_eq this.tourType 3}}🩺 Лечебный{{/if_eq}}
                    </span>
                    <span class="tour-id">#{{this.ID}}</span>
                </div>
                <div class="tour-body">
                    <h4>{{this.Name}}</h4>
                    <p class="tour-description">{{this.description}}</p>
                    <div class="tour-details">
                        <div class="detail">
                            <span class="label">Цена:</span>
                            <span class="value price">{{this.price}} ₽</span>
                        </div>
                        <div class="detail">
                            <span class="label">Места:</span>
                            <span class="value seats">{{this.seatsAvailable}}</span>
                        </div>
                    </div>
                </div>
                <div class="tour-footer">
                    <div class="tour-actions">
                        <form method="POST" action="/tours/{{this.ID}}/delete" class="inline-form">
                            <button type="submit" class="btn btn-sm btn-danger" 
                                    onclick="return confirm('Удалить тур \"{{this.Name}}\"?')">
                                Удалить
                            </button>
                        </form>
                    </div>
                    <div class="tour-date">
                        {{formatDate this.CreatedAt}}
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="empty-state">
            <p>Туров пока нет</p>
        </div>
        {{/if}}
    </div>
</div>

<script>
function showAddForm() {
    document.getElementById('addForm').style.display = 'block';
    window.scrollTo({ top: document.getElementById('addForm').offsetTop - 100, behavior: 'smooth' });
}

function hideAddForm() {
    document.getElementById('addForm').style.display = 'none';
    document.querySelector('#addForm form').reset();
}
</script>


<div class="crud-section">
    <h2>Редактирование клиента #{{client.ID}}</h2>
    
    <!-- Добавьте отладку данных -->
    <div style="background: #f0f0f0; padding: 10px; margin-bottom: 20px; display: none;" id="debugInfo">
        <strong>Отладка:</strong>
        <pre>{{stringify client}}</pre>
        <p>ID: {{client.ID}}</p>
        <p>FirstName: {{client.FirstName}}</p>
        <p>LastName: {{client.LastName}}</p>
    </div>
    
    <form method="POST" action="/clients/{{client.ID}}/update">
        <div class="form-grid">
            <div class="form-group">
                <label for="FirstName">Имя *</label>
                <input type="text" id="FirstName" name="FirstName" value="{{client.FirstName}}" required>
            </div>
            <div class="form-group">
                <label for="LastName">Фамилия *</label>
                <input type="text" id="LastName" name="LastName" value="{{client.LastName}}" required>
            </div>
            <div class="form-group">
                <label for="Phone">Телефон *</label>
                <input type="tel" id="Phone" name="Phone" value="{{client.Phone}}" required>
            </div>
            <div class="form-group">
                <label for="Email">Email *</label>
                <input type="email" id="Email" name="Email" value="{{client.Email}}" required>
            </div>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-success">💾 Сохранить изменения</button>
            <a href="/clients" class="btn btn-secondary">← Назад к списку</a>
        </div>
    </form>
    
    <div class="client-info mt-3">
        <h4>Дополнительная информация</h4>
        <div class="info-grid">
            <div class="info-item">
                <strong>ID клиента:</strong> {{client.ID}}
            </div>
            <div class="info-item">
                <strong>Дата регистрации:</strong> {{formatDate client.CreatedAt}}
            </div>
        </div>
    </div>
</div>

<script>
// Показываем отладочную информацию при нажатии Ctrl+Shift+D
document.addEventListener('keydown', function(e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'D') {
        e.preventDefault();
        const debugDiv = document.getElementById('debugInfo');
        debugDiv.style.display = debugDiv.style.display === 'none' ? 'block' : 'none';
    }
});

// Авто-проверка данных при загрузке
document.addEventListener('DOMContentLoaded', function() {
    console.log('Данные клиента:', {
        id: '{{client.ID}}',
        firstName: '{{client.FirstName}}',
        lastName: '{{client.LastName}}'
    });
    
    // Проверяем, заполнены ли поля формы
    const inputs = document.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"]');
    inputs.forEach(input => {
        console.log(`${input.id}: ${input.value}`);
    });
});
</script>

<style>
#debugInfo pre {
    background: white;
    padding: 10px;
    border-radius: 5px;
    overflow: auto;
    max-height: 200px;
}
</style>